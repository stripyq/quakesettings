---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Get all players to count hardware usage
const allPlayers = await getCollection('players');
const players = allPlayers.filter(p => p.data.published !== false);

// Create headset player list map
const headsetPlayersMap = new Map<string, typeof players>();
players.forEach(p => {
  const headsetId = p.data.headset;
  if (headsetId) {
    if (!headsetPlayersMap.has(headsetId)) {
      headsetPlayersMap.set(headsetId, []);
    }
    headsetPlayersMap.get(headsetId)!.push(p);
  }
});

// Player YAML may reference these older slugs instead of the collection id
const aliases: Record<string, string[]> = {
  'sennheiser-hd-560s': ['sennheiser-hd560s'],
  'sennheiser-hd-599': ['sennheiser-hd599', 'sennheiser-hd598'],
};

function getPlayersForHeadset(id: string): typeof players {
  return [id, ...(aliases[id] ?? [])].flatMap(slug => headsetPlayersMap.get(slug) ?? []);
}

const allHeadsets = await getCollection('headsets');
type Headset = (typeof allHeadsets)[number];
type Review = NonNullable<Headset['data']['reviews']>[number];

// priceEur ascending, missing prices last
function byPrice(a: Headset, b: Headset): number {
  const pa = a.data.priceEur;
  const pb = b.data.priceEur;
  if (pa == null || pb == null) {
    if (pa == null && pb == null) return a.data.name.localeCompare(b.data.name);
    return pa == null ? 1 : -1;
  }
  return pa - pb || a.data.name.localeCompare(b.data.name);
}

const recommended = allHeadsets.filter(h => h.data.recommendation === 'recommended');
const alternative = allHeadsets.filter(h => h.data.recommendation === 'alternative');

// Hand-picked, not derived from `recommendation`; the need label is fixed per slug
const quickPickNeeds: [string, string][] = [
  ['7hz-salnotes-zero-2', 'Cheapest useful'],
  ['truthear-hexa', 'Value IEM'],
  ['sennheiser-hd-560s', 'Open-back default'],
  ['beyerdynamic-dt-770-pro-x', 'Closed-back'],
  ['hyperx-cloud-iii', 'Headset with mic'],
  ['sennheiser-hd-490-pro', 'Premium comfort'],
];
const quickPicks = quickPickNeeds.map(([slug, need]) => {
  const h = allHeadsets.find(x => x.id === slug);
  if (!h) throw new Error(`Quick pick not found: ${slug}`);
  return { h, need };
});

// Recommended rows first, then alternatives; each group by price
function inCategories(categories: string[]): Headset[] {
  const pick = (list: Headset[]) => list.filter(h => h.data.category != null && categories.includes(h.data.category)).sort(byPrice);
  return [...pick(recommended), ...pick(alternative)];
}

const productSections = [
  { id: 'open-back', title: 'Open-back', rows: inCategories(['open', 'semi-open']),
    lead: 'Quiet room only. Wide, comfortable, zero isolation.' },
  { id: 'closed-back', title: 'Closed-back', rows: inCategories(['closed']),
    lead: 'Isolation without ear-canal insertion; weaker than IEMs, breaks with glasses.' },
  { id: 'iems', title: 'IEMs', rows: inCategories(['iem']),
    lead: 'Sealed, 20-35 dB of isolation, the LAN choice. Fit and tips decide the sound more than the model.' },
  { id: 'headsets', title: 'Headsets with microphone', rows: inCategories(['headset']),
    lead: 'One-box convenience. Convenience tier, not an acoustic one.' },
];

const accessoryRows = inCategories(['dac-amp', 'mic', 'accessory']);

// Form, back, connection, mic, in that order; only what the YAML states
function configChips(h: Headset): string[] {
  const d = h.data;
  const norm = (v: unknown) => (typeof v === 'string' ? v.trim().toLowerCase() : '');
  const formFactor = norm(d.formFactor);
  const type = norm(d.type);
  const backStyle = norm(d.backStyle);
  const connection = norm(d.connection);
  const chips: string[] = [];

  let form = '';
  if (formFactor === 'iem') form = 'IEM';
  else if (formFactor === 'over-ear') form = 'Over-ear';
  else if (formFactor === 'on-ear') form = 'On-ear';
  else if (formFactor.includes('clip')) form = 'Clip-on';
  else if (!formFactor) {
    if (type === 'in-ear') form = 'IEM';
    else if (type === 'open-back' || type === 'closed-back' || backStyle) form = 'Over-ear';
  }
  if (form) chips.push(form);

  const backLabels: Record<string, string> = {
    open: 'Open', 'semi-open': 'Semi-open', closed: 'Closed',
    'open-back': 'Open', 'closed-back': 'Closed',
  };
  const back = backStyle ? backLabels[backStyle] : backLabels[type];
  if (back && form !== 'IEM') chips.push(back);

  if (connection.includes('wired') && connection.includes('wireless')) chips.push('Wired + wireless');
  else if (['wireless', 'bluetooth', '2.4'].some(k => connection.includes(k))) chips.push('Wireless');
  else if (connection === 'wired') chips.push('Wired');

  const mic: unknown = d.microphone;
  if (typeof mic === 'boolean') chips.push(mic ? 'Mic' : 'No mic');
  else if (typeof mic === 'string' && mic.trim()) chips.push(/^(no|none|false)$/i.test(mic.trim()) ? 'No mic' : 'Mic');

  return chips;
}

// Measurement sources only; the 2025 reviewer marks and 'historical' verdicts are not shown
const sourceLabels: Record<string, string> = {
  rtings: 'RTINGS', asr: 'ASR', crinacle: 'Crin', oratory1990: 'o1990', gadgetrytech: 'GT',
  soundguys: 'SG', headphones_com: 'HP.com',
};
const verdictMarks: Record<string, string> = { recommended: ' ✓', not_recommended: ' ✗', mixed: ' ~' };

function evidenceFor(h: Headset): Review[] {
  return (h.data.reviews ?? []).filter(r => r.source in sourceLabels && r.verdict !== 'historical');
}

function badgeText(r: Review): string {
  return sourceLabels[r.source] + (verdictMarks[r.verdict] ?? '');
}

function reviewTitle(r: Review): string {
  return [r.verdict.replace('_', ' '), r.date, r.note].filter(Boolean).join(' · ');
}

function priceTitle(h: Headset): string {
  return h.data.priceChecked ? `approximate, checked ${h.data.priceChecked}` : 'approximate';
}

// Quick picks show whyBuy / whyNot as columns; the category tables keep them as a tooltip on the model name
function modelTitle(h: Headset): string | undefined {
  const parts = [h.data.whyBuy && `Why buy: ${h.data.whyBuy}`, h.data.whyNot && `Why not: ${h.data.whyNot}`].filter(Boolean);
  return parts.length ? parts.join('\n') : undefined;
}

const priorities = [
  ['Localisation and cue recognition', 'Critical'],
  ['Tonal balance (no bass bloat, no harsh peaks)', 'High'],
  ['Isolation', 'Depends on your room'],
  ['Comfort over long sessions', 'High'],
  ['Soundstage width', 'Secondary'],
  ['Driver type or count', 'Not a buying criterion'],
];

const mistakes = [
  ['Bass-heavy gaming headset', 'Neutral tuning, cut mid-bass if needed'],
  ['Two spatialisers at once', "One pipeline: the game's, or exactly one external for stereo-only games"],
  ['Turning volume up to hear footsteps', 'Fix isolation and balance first'],
  ['Buying by driver type or count', 'Buy by measurements, fit, comfort'],
  ['Widest soundstage = best positioning', 'Spaciousness is not accuracy'],
  ['Expensive DAC without a problem to solve', 'Upgrade for hiss, power or connectivity only'],
  ["Copying a pro's gear without context", 'Their room, sponsor and preferences are not yours'],
  ['Assuming IEMs beat open-backs, or the reverse', 'Choose by environment and fit'],
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Competitive FPS audio recommendations for Quake Live",
  "description": "IEMs, open-back and closed-back headphones, headsets, sources, game audio settings and EQ for Quake Live and arena shooters, updated October 2026.",
  "url": "https://stripyq.github.io/quakesettings/recommendations/headsets/"
};
---

<BaseLayout title="Competitive FPS audio" description="Recommendations for Quake Live and arena shooters, updated October 2026" schema={schema} ogImage="/images/og/recommendations.jpg">
  <div class="page-header">
    <h1>Competitive FPS audio</h1>
    <p>Recommendations for Quake Live and arena shooters, updated October 2026</p>
  </div>

  <p class="intro">The game engine computes direction and distance, and the headphone only has to deliver that signal cleanly, so do not stack a spatialiser on top. What matters is neutral tuning, matched left and right channels and a good fit, not driver type or "7.1". Use open-backs in a quiet room and sealed IEMs anywhere noisy, and keep in mind that nothing on this page is proven to raise rank.</p>

  <nav class="page-nav" aria-label="On this page">
    <a href="#quick-picks">Quick picks</a>
    <a href="#price-bands">Price bands</a>
    <a href="#open-back">Open-back</a>
    <a href="#closed-back">Closed-back</a>
    <a href="#iems">IEMs</a>
    <a href="#headsets">Headsets</a>
    <a href="#sources">Accessories</a>
    <a href="#quake-setup">Quake Live setup</a>
  </nav>

  <section id="quick-picks">
    <h2 class="section-title">Quick picks</h2>
    <div class="table-container">
      <table class="rec-table quick-picks">
        <thead>
          <tr>
            <th>Need</th>
            <th>Pick</th>
            <th class="num">~EUR</th>
            <th>Configuration</th>
            <th>Why</th>
            <th>Why not</th>
          </tr>
        </thead>
        <tbody>
          {quickPicks.map(({ h, need }) => {
            const d = h.data;
            const chips = configChips(h);
            return (
              <tr>
                <td class="notes" data-label="Need">{need}</td>
                <td class="headset-name" data-label="Pick">
                  {d.name}
                  {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                </td>
                {d.priceEur != null
                  ? <td class="price num" data-label="~EUR" title={priceTitle(h)}>{d.priceEur}</td>
                  : <td class="price num" data-label="~EUR"><span class="empty-val">—</span></td>}
                <td data-label="Configuration">
                  {chips.length > 0
                    ? <div class="config-chips">{chips.map(c => <span class="chip">{c}</span>)}</div>
                    : <span class="empty-val">—</span>}
                </td>
                <td class="notes" data-label="Why">{d.whyBuy || <span class="empty-val">—</span>}</td>
                <td class="notes" data-label="Why not">{d.whyNot || <span class="empty-val">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section id="price-bands">
    <h2 class="section-title">What are you paying for</h2>
    <div class="callout">
      <p class="callout-head">Does 1,000 EUR buy 4x better positioning than 250 EUR? No evidence says so.</p>
      <div class="bands">
        <div class="band band-primary">
          <div class="band-price">20-150 EUR</div>
          <div class="band-title">Best value</div>
          <div class="band-text">Accurate tuning, matched channels, a good fit: the things that decide whether you hear the enemy.</div>
          <div class="band-ex">KSC75 · Zero:2 · Hexa · HD 560S</div>
        </div>
        <div class="band">
          <div class="band-price">150-350 EUR</div>
          <div class="band-title">More choice</div>
          <div class="band-text">Comfort, build, tuning variants, a reference sound without EQ.</div>
          <div class="band-ex">DT 900 Pro X · HD 490 Pro · CrinEar Reference</div>
        </div>
        <div class="band">
          <div class="band-price">350+ EUR</div>
          <div class="band-title">Preference</div>
          <div class="band-text">Materials, music, personal taste. No demonstrated competitive gain.</div>
          <div class="band-ex">Flagships</div>
        </div>
      </div>
      <p class="callout-foot">Price cannot fix the wrong type: a well-sealed 50 EUR IEM is usually more useful than a 500 EUR open-back in a noisy room.</p>
      <p class="callout-note">Indicative price bands, not measured thresholds.</p>
    </div>
  </section>

  {productSections.map(section => (
    <section id={section.id}>
      <h2 class="section-title">{section.title}</h2>
      <p class="lead">{section.lead}</p>
      <div class="table-container">
        <table class="rec-table products">
          <thead>
            <tr>
              <th>Model</th>
              <th class="num">~EUR</th>
              <th>Configuration</th>
              <th>Use case</th>
              <th>Evidence</th>
              <th>Players</th>
            </tr>
          </thead>
          <tbody>
            {section.rows.map(h => {
              const d = h.data;
              const rowPlayers = getPlayersForHeadset(h.id);
              const badges = evidenceFor(h);
              const chips = configChips(h);
              return (
                <tr>
                  <td class="headset-name" data-label="Model" title={modelTitle(h)}>
                    {d.name}
                    {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                  </td>
                  {d.priceEur != null
                    ? <td class="price num" data-label="~EUR" title={priceTitle(h)}>{d.priceEur}</td>
                    : <td class="price num" data-label="~EUR"><span class="empty-val">—</span></td>}
                  <td data-label="Configuration">
                    {chips.length > 0
                      ? <div class="config-chips">{chips.map(c => <span class="chip">{c}</span>)}</div>
                      : <span class="empty-val">—</span>}
                  </td>
                  <td class="notes" data-label="Use case">{d.useCase || <span class="empty-val">—</span>}</td>
                  <td class="evidence" data-label="Evidence">
                    {badges.length > 0 ? badges.map(r => r.url
                      ? <a class="badge" href={r.url} title={reviewTitle(r)} target="_blank" rel="noopener">{badgeText(r)}</a>
                      : <span class="badge" title={reviewTitle(r)}>{badgeText(r)}</span>
                    ) : <span class="empty-val">—</span>}
                  </td>
                  <td class="players" data-label="Players">
                    {rowPlayers.length > 0 ? (
                      <div class="usage-wrapper">
                        <span class="usage-count">{rowPlayers.length}</span>
                        <div class="player-dropdown">
                          {rowPlayers.map(p => (
                            <a href={`${base}players/${p.id}/`}>{p.data.name}</a>
                          ))}
                        </div>
                      </div>
                    ) : <span class="empty-val">—</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section id="sources">
    <h2 class="section-title">Optional accessories</h2>
    <p class="lead">If your PC already gives clean audio at enough volume, you need none of this. Buy only to fix a specific problem.</p>
    <div class="table-container">
      <table class="rec-table sources">
        <thead>
          <tr>
            <th>Accessory</th>
            <th class="num">~EUR</th>
            <th>When you need it</th>
          </tr>
        </thead>
        <tbody>
          {accessoryRows.map(h => {
            const d = h.data;
            return (
              <tr>
                <td class="headset-name" data-label="Accessory" title={modelTitle(h)}>
                  {d.name}
                  {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                </td>
                {d.priceEur != null
                  ? <td class="price num" data-label="~EUR" title={priceTitle(h)}>{d.priceEur}</td>
                  : <td class="price num" data-label="~EUR"><span class="empty-val">—</span></td>}
                <td class="notes" data-label="When you need it">{d.useCase || <span class="empty-val">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section id="principles">
    <h2 class="section-title">Principles</h2>
    <p class="body-text">Spatial accuracy depends on several things at once: how the game renders sound, the frequency and phase response of the headphone at your ear, how closely the two channels match, the fit, and your own hearing. Open-backs often sound more spacious. Sealed IEMs isolate better. Neither guarantees better positioning.</p>
    <div class="table-container">
      <table class="rec-table pairs">
        <thead>
          <tr>
            <th>Factor</th>
            <th>Priority</th>
          </tr>
        </thead>
        <tbody>
          {priorities.map(([factor, priority]) => (
            <tr><td class="headset-name" data-label="Factor">{factor}</td><td class="notes" data-label="Priority">{priority}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="mistakes">
    <h2 class="section-title">Common mistakes</h2>
    <div class="table-container">
      <table class="rec-table pairs">
        <thead>
          <tr>
            <th>Mistake</th>
            <th>Better</th>
          </tr>
        </thead>
        <tbody>
          {mistakes.map(([mistake, better]) => (
            <tr><td class="headset-name" data-label="Mistake">{mistake}</td><td class="notes" data-label="Better">{better}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="quake-setup">
    <h2 class="section-title">Audio setup for Quake Live</h2>
    <ul class="body-list">
      <li>Output plain stereo. No virtual surround and no stacked spatialisers; an external one is an optional experiment, never two at once.</li>
      <li>Keep the volume moderate. Do not compensate for poor isolation with loudness.</li>
      <li>Learn the map's movement, item and weapon sounds. They matter more than gear.</li>
      <li>Use EQ only for an identified tonal problem, starting from a measured preset for your model (Equalizer APO with Peace, <a href="https://www.reddit.com/r/oratory1990/wiki/index/list_of_presets" target="_blank" rel="noopener">oratory1990 preset list</a>). Cut mid-bass by 2-4 dB if explosions mask steps; no narrow treble boosts.</li>
      <li>Upgrade a DAC or amp only for hiss, volume or connectivity.</li>
    </ul>
    <p class="body-text">Quake Champions: stereo baseline, its HRTF toggle was removed in 2024. CS2 and Valorant: native HRTF, leave it on and add nothing.</p>
  </section>

  <div class="back-link">
    <a href={`${base}recommendations/`}>← Back to Recommendations</a>
  </div>
</BaseLayout>

<style>
  /* Sticky site nav: 71px from about 920px up (it wraps to two rows below that), 131px on phones; plus 1rem */
  section[id] {
    scroll-margin-top: 148px;
  }

  @media (min-width: 920px) {
    section[id] {
      scroll-margin-top: 88px;
    }
  }

  .intro,
  .body-text,
  .body-list li {
    color: var(--text-secondary, #888);
    line-height: 1.6;
  }

  .body-text {
    margin-bottom: 0.75rem;
  }

  .body-list {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .page-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    font-size: 0.9rem;
    margin: 0.5rem 0 1.5rem;
  }

  .page-nav a {
    color: var(--text-secondary);
  }

  .page-nav a:hover {
    color: var(--accent-primary);
  }

  .lead {
    margin-bottom: 0.75rem;
    color: var(--text-muted, #9090a0);
  }

  .section-title {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: var(--text-primary, #fff);
    border-bottom: 1px solid var(--border-color, #2a2a3a);
    padding-bottom: 0.5rem;
  }

  .table-container {
    margin-bottom: 1rem;
  }

  .rec-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .rec-table th,
  .rec-table td {
    padding: 0.5rem 0.4rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color, #2a2a3a);
    overflow-wrap: break-word;
  }

  .rec-table th {
    background: var(--bg-secondary, #12121a);
  }

  .rec-table tbody tr:hover {
    background: var(--bg-secondary, #12121a);
  }

  /* Need, Pick, ~EUR, Configuration, Why, Why not */
  .quick-picks th:nth-child(1) { width: 14%; }
  .quick-picks th:nth-child(2) { width: 20%; }
  .quick-picks th:nth-child(3) { width: 7%; }
  .quick-picks th:nth-child(4) { width: 22%; }
  .quick-picks th:nth-child(5) { width: 20%; }
  .quick-picks th:nth-child(6) { width: 17%; }

  /* Model, ~EUR, Configuration, Use case, Evidence, Players */
  .products th:nth-child(1) { width: 24%; }
  .products th:nth-child(2) { width: 7%; }
  .products th:nth-child(3) { width: 24%; }
  .products th:nth-child(4) { width: 21%; }
  .products th:nth-child(5) { width: 12%; }
  .products th:nth-child(6) { width: 12%; }

  /* Accessory, ~EUR, When you need it */
  .sources th:nth-child(1) { width: 30%; }
  .sources th:nth-child(2) { width: 10%; }
  .sources th:nth-child(3) { width: 60%; }

  .pairs th:nth-child(1) { width: 40%; }
  .pairs th:nth-child(2) { width: 60%; }

  .quick-picks td {
    vertical-align: top;
  }

  .headset-name {
    font-weight: 500;
    color: var(--text-primary, #fff);
  }

  .price {
    font-family: monospace;
    color: var(--text-secondary, #888);
  }

  .config-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: center;
  }

  .chip {
    display: inline-block;
    font-size: 0.78rem;
    line-height: 1.4;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .callout {
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-primary);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 0.5rem 0 1.5rem;
  }

  .callout-head {
    font-weight: 600;
    margin: 0 0 0.9rem;
  }

  .bands {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .band-price {
    font-weight: 600;
  }

  .band-title {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .band-primary .band-title {
    color: var(--accent-primary);
  }

  .band-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .band-ex {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }

  .callout-foot {
    margin: 1rem 0 0;
  }

  .callout-note {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0;
  }

  .players {
    font-weight: 600;
  }

  .products th:last-child,
  .products td:last-child {
    text-align: right;
    padding-right: 24px;
  }

  .usage-wrapper {
    position: relative;
    display: inline-block;
    cursor: pointer;
  }

  /* global.css gives .usage-count a top border and padding meant for the hardware cards */
  .usage-count {
    padding-top: 0;
    border-top: none;
    color: var(--accent-primary, #ff6b35);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .usage-wrapper:hover .usage-count {
    color: var(--accent-secondary, #4ecdc4);
  }

  .player-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    background: var(--bg-primary, #0a0a0f);
