---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AudioValueCurve from '../../components/AudioValueCurve.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Get all players to count hardware usage
const allPlayers = await getCollection('players');
const players = allPlayers.filter(p => p.data.published !== false);

// Create headset player list map
const headsetPlayersMap = new Map<string, typeof players>();
players.forEach(p => {
  const headsetId = p.data.headset;
  if (headsetId) {
    if (!headsetPlayersMap.has(headsetId)) {
      headsetPlayersMap.set(headsetId, []);
    }
    headsetPlayersMap.get(headsetId)!.push(p);
  }
});

// Player YAML may reference these older slugs instead of the collection id
const aliases: Record<string, string[]> = {
  'sennheiser-hd-560s': ['sennheiser-hd560s'],
  'sennheiser-hd-599': ['sennheiser-hd599', 'sennheiser-hd598'],
};

function getPlayersForHeadset(id: string): typeof players {
  return [id, ...(aliases[id] ?? [])].flatMap(slug => headsetPlayersMap.get(slug) ?? []);
}

const allHeadsets = await getCollection('headsets');
type Headset = (typeof allHeadsets)[number];
type Review = NonNullable<Headset['data']['reviews']>[number];

// priceEur ascending, missing prices last
function byPrice(a: Headset, b: Headset): number {
  const pa = a.data.priceEur;
  const pb = b.data.priceEur;
  if (pa == null || pb == null) {
    if (pa == null && pb == null) return a.data.name.localeCompare(b.data.name);
    return pa == null ? 1 : -1;
  }
  return pa - pb || a.data.name.localeCompare(b.data.name);
}

const recommended = allHeadsets.filter(h => h.data.recommendation === 'recommended');
const alternative = allHeadsets.filter(h => h.data.recommendation === 'alternative');
const historical = allHeadsets.filter(h => h.data.recommendation === 'historical');

// Quick picks: every recommended product, by category (schema order) then price
const categoryOrder = ['iem', 'open', 'semi-open', 'closed', 'headset', 'dac-amp', 'mic', 'accessory'];
const quickPicks = [...recommended].sort((a, b) =>
  categoryOrder.indexOf(a.data.category ?? '') - categoryOrder.indexOf(b.data.category ?? '') || byPrice(a, b));

// Recommended rows first, then alternatives; each group by price
function inCategories(categories: string[]): Headset[] {
  const pick = (list: Headset[]) => list.filter(h => h.data.category != null && categories.includes(h.data.category)).sort(byPrice);
  return [...pick(recommended), ...pick(alternative)];
}

// variant: 'specs' = spec columns + evidence, 'source' = no spec columns and a "nothing" first row
const sections = [
  { title: 'IEMs', id: 'rec-table-iem', variant: 'specs', rows: inCategories(['iem']),
    lead: 'Sealed, 20-35 dB of isolation, the LAN choice. Fit and tips decide the sound more than the model.' },
  { title: 'Open-back', id: 'rec-table-open', variant: 'specs', rows: inCategories(['open', 'semi-open']),
    lead: 'Quiet room only. Wide, comfortable, zero isolation.' },
  { title: 'Closed-back', id: 'rec-table-closed', variant: 'specs', rows: inCategories(['closed']),
    lead: 'Isolation without ear-canal insertion; weaker than IEMs, breaks with glasses.' },
  { title: 'Headsets with microphone', id: 'rec-table-headset', variant: 'specs', rows: inCategories(['headset']),
    lead: 'One-box convenience. Convenience tier, not an acoustic one.' },
  { title: 'Sources, microphones, accessories', id: 'rec-table-sources', variant: 'source', rows: inCategories(['dac-amp', 'mic', 'accessory']),
    lead: 'Buy only to fix an identified problem: hiss, not enough volume, no mic, LAN noise. Row one: you may need nothing.' },
];

const archiveRows = [...historical].sort(byPrice);

const measurementSources = new Set(['rtings', 'asr', 'crinacle', 'oratory1990', 'gadgetrytech', 'soundguys', 'headphones_com']);
const sourceLabels: Record<string, string> = {
  rtings: 'RTINGS', asr: 'ASR', crinacle: 'Crin', oratory1990: 'o1990', gadgetrytech: 'GT',
  soundguys: 'SG', headphones_com: 'HP.com', badseed: 'BS', joshuavalour: 'JV', mle: 'MLE',
};

// Current tables show measurement sources only; the 2025 'historical' marks stay in the archive table
function evidenceFor(h: Headset): Review[] {
  return (h.data.reviews ?? []).filter(r => measurementSources.has(r.source) && r.verdict !== 'historical');
}

function reviewTitle(r: Review): string {
  return [r.verdict.replace('_', ' '), r.date, r.note].filter(Boolean).join(' · ');
}

function priceTitle(h: Headset): string {
  return h.data.priceChecked ? `approximate, checked ${h.data.priceChecked}` : 'approximate';
}

// Quick picks show whyBuy / whyNot as columns; the category tables keep them as a tooltip on the model name
function modelTitle(h: Headset): string | undefined {
  const parts = [h.data.whyBuy && `Why buy: ${h.data.whyBuy}`, h.data.whyNot && `Why not: ${h.data.whyNot}`].filter(Boolean);
  return parts.length ? parts.join('\n') : undefined;
}

function fmtMic(data: any): string {
  if (!data) return '—';
  return data.microphone ? 'Yes' : 'No';
}

const priorities = [
  ['Localisation and cue recognition', 'Critical'],
  ['Tonal balance (no bass bloat, no harsh peaks)', 'High'],
  ['Isolation', 'Depends on your room'],
  ['Comfort over long sessions', 'High'],
  ['Soundstage width', 'Secondary'],
  ['Driver type or count', 'Not a buying criterion'],
];

const mistakes = [
  ['Bass-heavy gaming headset', 'Neutral tuning, cut mid-bass if needed'],
  ['Two spatialisers at once', "One pipeline: the game's, or exactly one external for stereo-only games"],
  ['Turning volume up to hear footsteps', 'Fix isolation and balance first'],
  ['Buying by driver type or count', 'Buy by measurements, fit, comfort'],
  ['Widest soundstage = best positioning', 'Spaciousness is not accuracy'],
  ['Expensive DAC without a problem to solve', 'Upgrade for hiss, power or connectivity only'],
  ["Copying a pro's gear without context", 'Their room, sponsor and preferences are not yours'],
  ['Assuming IEMs beat open-backs, or the reverse', 'Choose by environment and fit'],
];

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Competitive FPS audio recommendations for Quake Live",
  "description": "IEMs, open-back and closed-back headphones, headsets, sources, game audio settings and EQ for Quake Live and arena shooters, updated October 2026.",
  "url": "https://stripyq.github.io/quakesettings/recommendations/headsets/"
};
---

<BaseLayout title="Competitive FPS audio" description="Recommendations for Quake Live and arena shooters, updated October 2026" schema={schema} ogImage="/images/og/recommendations.jpg">
  <div class="page-header">
    <h1>Competitive FPS audio</h1>
    <p>Recommendations for Quake Live and arena shooters, updated October 2026</p>
    <p class="scope">Primary focus: Quake Live and arena shooters. Other FPS games follow the same hardware advice but have their own audio engines; see the game settings section.</p>
  </div>

  <section id="intro" class="guide">
    <ul>
      <li>The game engine computes direction and distance; the headphone only has to deliver that signal cleanly. Do not add a second spatialiser on top.</li>
      <li>What matters in hardware: tuning close to a known target, matched left and right channels, a good fit or seal, low distortion. Not driver type, not driver count, not "7.1".</li>
      <li>Isolation is the real difference between the two sane options: open-back headphones in a quiet room, sealed IEMs anywhere noisy. Pros wear IEMs under earmuffs at LAN; the IEMs carry the game, the muffs block the crowd.</li>
      <li>Nothing on this page is proven to raise rank. The step from a bass-heavy headset with virtual surround to a sane setup is large; every step after that is small.</li>
    </ul>
  </section>

  <section id="quick-picks">
    <h2 class="section-title">Quick picks</h2>
    <div class="table-container">
      <table class="rec-table quick-picks" id="rec-table-quick">
        <thead>
          <tr>
            <th>Situation</th>
            <th>Pick</th>
            <th class="num">~EUR</th>
            <th>Why</th>
            <th>Why not</th>
          </tr>
        </thead>
        <tbody>
          {quickPicks.map(h => {
            const d = h.data;
            return (
              <tr>
                <td class="notes">{d.useCase || <span class="empty-val">—</span>}</td>
                <td class="headset-name">
                  {d.name}
                  {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                </td>
                {d.priceEur != null
                  ? <td class="price num" title={priceTitle(h)}>{d.priceEur}</td>
                  : <td class="price num"><span class="empty-val">—</span></td>}
                <td class="notes">{d.whyBuy || <span class="empty-val">—</span>}</td>
                <td class="notes">{d.whyNot || <span class="empty-val">—</span>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <p class="footnote">Prices are approximate EU street prices, checked on the date in each row's tooltip.</p>
  </section>

  <section id="diminishing-returns" class="guide">
    <h2 class="section-title">What are you paying for? Diminishing returns</h2>
    <figure class="chart">
      <AudioValueCurve />
      <figcaption>Conceptual illustration, not a measured relationship. Individual products can fall above or below the line depending on fit, environment and the player.</figcaption>
    </figure>
    <p>The first 100-200 EUR buys the things that decide what you hear: accurate reproduction, matched channels and a good fit. From about 150 to 350 EUR you pay for comfort, build quality and tuning variants that suit you without EQ. Above that you pay for materials, music performance and preference.</p>
    <p>Price cannot compensate for the wrong type. A sealed 50 EUR IEM is more useful in a noisy room than a 500 EUR open-back; a comfortable 140 EUR open-back beats an expensive IEM in a quiet room over long sessions.</p>
  </section>

  {sections.map(section => (
    <section id={section.id.replace('rec-table-', 'products-')}>
      <h2 class="section-title">{section.title}</h2>
      <p class="lead">{section.lead}</p>
      <div class="table-container">
        <table class:list={['rec-table', { 'rec-sortable': section.variant !== 'source' }]} id={section.id}>
          <thead>
            <tr>
              <th>Model</th>
              <th class="num">Price</th>
              {section.variant !== 'source' && (
                <Fragment>
                  <th class="sortable" data-sort="form" data-type="str">Form</th>
                  <th class="sortable" data-sort="back" data-type="str">Back</th>
                  <th class="sortable" data-sort="conn" data-type="str">Conn</th>
                  <th class="sortable" data-sort="mic" data-type="str">Mic</th>
                </Fragment>
              )}
              <th>Use case</th>
              <th>Evidence</th>
              <th class="num">Players</th>
            </tr>
          </thead>
          <tbody>
            {section.variant === 'source' && (
              <tr>
                <td class="headset-name">Nothing new</td>
                <td class="price num">0</td>
                <td class="notes">no hiss, enough volume, a working mic, a quiet room</td>
                <td class="evidence"><span class="empty-val">—</span></td>
                <td class="players num"><span class="empty-val">—</span></td>
              </tr>
            )}
            {section.rows.map(h => {
              const d = h.data;
              const rowPlayers = getPlayersForHeadset(h.id);
              const badges = evidenceFor(h);
              return (
                <tr data-form={d.formFactor || ''} data-back={d.backStyle || ''} data-conn={d.connection || ''} data-mic={fmtMic(d)}>
                  <td class="headset-name" title={modelTitle(h)}>
                    {d.name}
                    {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                  </td>
                  {d.priceEur != null
                    ? <td class="price num" title={priceTitle(h)}>~{d.priceEur}</td>
                    : <td class="price num"><span class="empty-val">—</span></td>}
                  {section.variant !== 'source' && (
                    <Fragment>
                      <td class="spec">{d.formFactor || <span class="empty-val">—</span>}</td>
                      <td class="spec">{d.backStyle || <span class="empty-val">—</span>}</td>
                      <td class="spec">{d.connection || <span class="empty-val">—</span>}</td>
                      <td class="spec">{fmtMic(d)}</td>
                    </Fragment>
                  )}
                  <td class="notes">{d.useCase || <span class="empty-val">—</span>}</td>
                  <td class="evidence">
                    {badges.length > 0 ? badges.map(r => r.url
                      ? <a class="badge" href={r.url} title={reviewTitle(r)} target="_blank" rel="noopener">{sourceLabels[r.source]}</a>
                      : <span class="badge" title={reviewTitle(r)}>{sourceLabels[r.source]}</span>
                    ) : <span class="empty-val">—</span>}
                  </td>
                  <td class="players num">
                    {rowPlayers.length > 0 ? (
                      <div class="usage-wrapper">
                        <span class="usage-count">{rowPlayers.length}</span>
                        <div class="player-dropdown">
                          {rowPlayers.map(p => (
                            <a href={`${base}players/${p.id}/`}>{p.data.name}</a>
                          ))}
                        </div>
                      </div>
                    ) : <span class="empty-val">—</span>}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  ))}

  <section id="game-audio-settings" class="guide">
    <h2 class="section-title">Game audio settings</h2>
    <h3>Quake Live</h3>
    <p>The engine pans sounds in stereo and has no HRTF. Start with plain stereo. An external spatialiser (Windows Sonic, Dolby Atmos) is an optional experiment, not a recommended upgrade: it cannot recover positions from a stereo signal that is already mixed. If you try one, test it for a week, and never run two.</p>
    <h3>Quake Champions</h3>
    <p>The game had a beta HRTF toggle from June 2018. The July 2024 update moved it to a new FMOD audio system and removed the toggle. Use stereo as the baseline; the game also offers multichannel output you can compare against. It has been a paid title since September 2026, with no further content updates announced.</p>
    <h3>CS2 and Valorant</h3>
    <p>Native HRTF is built in. Leave it on and add nothing. Valorant 8.0 supports selected third-party spatialisers and disables its own when you pick one.</p>
    <p>Volume: louder does not reveal detail, it masks it. Set it so distant steps are audible and gunfire is not painful, then leave it.</p>
  </section>

  <section id="eq" class="guide">
    <h2 class="section-title">EQ</h2>
    <p>No universal footstep EQ exists. Start from a measured preset for your exact model: Equalizer APO with Peace on Windows, and an <a href="https://www.reddit.com/r/oratory1990/wiki/index/list_of_presets" target="_blank" rel="noopener">oratory1990</a> or AutoEQ preset as the starting point. Moderate cuts and moderate boosts are both fine. Positive gain needs headroom: lower the pre-amp so boosted sounds do not clip. Avoid large, narrow corrections based on generic claims about footstep frequencies. Harman, diffuse-field and JM-1 are tonal references; none of them has been validated for FPS.</p>
    <figure class="eq-example">
      <figcaption>Equalizer APO syntax example (a demonstration, not a Quake profile)</figcaption>
      <pre><code>Preamp: -1 dB
Filter 1: ON LSC Fc 80 Hz Gain -2 dB Q 0.7
Filter 2: ON PK  Fc 150 Hz Gain -3 dB Q 1.0</code></pre>
    </figure>
  </section>

  <section id="principles" class="guide">
    <h2 class="section-title">Principles</h2>
    <p>Spatial accuracy depends on several things at once: how the game renders sound, the frequency and phase response of the headphone at your ear, how closely the two channels match, the fit, and your own hearing. Open-backs often sound more spacious. Sealed IEMs isolate better. Neither guarantees better positioning.</p>
    <div class="table-container">
      <table class="rec-table info-table">
        <thead>
          <tr>
            <th>Factor</th>
            <th>Priority</th>
          </tr>
        </thead>
        <tbody>
          {priorities.map(([factor, priority]) => (
            <tr><td class="headset-name">{factor}</td><td class="notes">{priority}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="common-mistakes">
    <h2 class="section-title">Common mistakes</h2>
    <div class="table-container">
      <table class="rec-table info-table">
        <thead>
          <tr>
            <th>Mistake</th>
            <th>Better</th>
          </tr>
        </thead>
        <tbody>
          {mistakes.map(([mistake, better]) => (
            <tr><td class="headset-name">{mistake}</td><td class="notes">{better}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="archive">
    <h2 class="section-title">Archive: historical and player gear</h2>
    <p class="lead">Products from the 2025 reviewer list and gear documented on player pages. Kept for reference; player usage is observational, not a recommendation.</p>
    <div class="table-container">
      <table class="rec-table rec-sortable" id="rec-table-archive">
        <thead>
          <tr>
            <th>Model</th>
            <th class="num">Price</th>
            <th class="sortable" data-sort="form" data-type="str">Form</th>
            <th class="sortable" data-sort="back" data-type="str">Back</th>
            <th class="sortable" data-sort="conn" data-type="str">Conn</th>
            <th class="sortable" data-sort="mic" data-type="str">Mic</th>
            <th>Legacy sources</th>
            <th class="num">Players</th>
          </tr>
        </thead>
        <tbody>
          {archiveRows.map(h => {
            const d = h.data;
            const rowPlayers = getPlayersForHeadset(h.id);
            const badges = d.reviews ?? [];
            return (
              <tr data-form={d.formFactor || ''} data-back={d.backStyle || ''} data-conn={d.connection || ''} data-mic={fmtMic(d)}>
                <td class="headset-name" title={modelTitle(h)}>
                  {d.name}
                  {d.disclosure && <span class="disclosure" title={d.disclosure}> ⓘ</span>}
                </td>
                {d.priceEur != null
                  ? <td class="price num" title={priceTitle(h)}>~{d.priceEur}</td>
                  : <td class="price num"><span class="empty-val">—</span></td>}
                <td class="spec">{d.formFactor || <span class="empty-val">—</span>}</td>
                <td class="spec">{d.backStyle || <span class="empty-val">—</span>}</td>
                <td class="spec">{d.connection || <span class="empty-val">—</span>}</td>
                <td class="spec">{fmtMic(d)}</td>
                <td class="evidence">
                  {badges.length > 0 ? badges.map(r => r.url
                    ? <a class="badge" href={r.url} title={reviewTitle(r)} target="_blank" rel="noopener">{sourceLabels[r.source]}</a>
                    : <span class="badge" title={reviewTitle(r)}>{sourceLabels[r.source]}</span>
                  ) : <span class="empty-val">—</span>}
                </td>
                <td class="players num">
                  {rowPlayers.length > 0 ? (
                    <div class="usage-wrapper">
                      <span class="usage-count">{rowPlayers.length}</span>
                      <div class="player-dropdown">
                        {rowPlayers.map(p => (
                          <a href={`${base}players/${p.id}/`}>{p.data.name}</a>
                        ))}
                      </div>
                    </div>
                  ) : <span class="empty-val">—</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section id="how-this-page-is-made" class="guide">
    <h2 class="section-title">How this page is made</h2>
    <p>Recommendations combine independent measurements (RTINGS on the B&amp;K 5128 rig, Audio Science Review, GadgetryTech's headset measurements, Crinacle for IEMs), model-specific EQ references (oratory1990), EU prices with a check date, and the gear Quake players report. Reviewer badges link to the source. GT, BS, JV and MLE marks from the 2025 list are kept as historical. Where sources disagree, the original is linked so you can judge.</p>
    <div class="source-legend">
      <span class="legend-item"><strong>Evidence sources:</strong></span>
      <span class="legend-item"><strong>RTINGS</strong> B&amp;K 5128 measurements</span>
      <span class="legend-item"><strong>ASR</strong> Audio Science Review (GRAS measurements)</span>
      <span class="legend-item"><strong>GT</strong> GadgetryTech (gaming headsets, measurements)</span>
      <span class="legend-item"><strong>Crin</strong> Crinacle (IEM measurements)</span>
      <span class="legend-item"><strong>o1990</strong> oratory1990 (EQ presets)</span>
      <span class="legend-item"><strong>BS, JV, MLE</strong> BadSeed Tech, Joshua Valour, Mad Lust Envy (2025 list, archive only)</span>
    </div>
  </section>

  <div class="back-link">
    <a href={`${base}recommendations/`}>← Back to Recommendations</a>
  </div>
</BaseLayout>

<style>
  .page-header .scope {
    max-width: 46rem;
    margin: 0.75rem auto 0;
    font-size: 0.9rem;
    color: var(--text-muted, #9090a0);
  }

  .guide p,
  .guide li {
    color: var(--text-secondary, #888);
    line-height: 1.6;
  }

  .guide p {
    margin-bottom: 0.75rem;
  }

  .guide ul {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  .guide h3 {
    margin: 1rem 0 0.25rem;
    font-size: 1rem;
    color: var(--text-primary, #fff);
  }

  .lead {
    margin-bottom: 0.75rem;
    color: var(--text-secondary, #888);
  }

  .footnote {
    margin-bottom: 1rem;
    font-size: 0.8rem;
    color: var(--text-muted, #9090a0);
  }

  .chart {
    margin: 0 0 1rem;
  }

  .chart figcaption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-style: italic;
    color: var(--text-muted, #9090a0);
  }

  .eq-example {
    margin: 0 0 1rem;
  }

  .eq-example figcaption {
    margin-bottom: 0.25rem;
    font-size: 0.8rem;
    color: var(--text-muted, #9090a0);
  }

  .eq-example pre {
    overflow-x: auto;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary, #12121a);
    border: 1px solid var(--border-color, #2a2a3a);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: var(--text-primary, #fff);
  }

  .source-legend {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--bg-secondary, #12121a);
    border-radius: var(--radius-md);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .section-title {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    color: var(--text-primary, #fff);
    border-bottom: 1px solid var(--border-color, #2a2a3a);
    padding-bottom: 0.5rem;
  }

  .table-container {
    overflow-x: visible;
    margin-bottom: 1rem;
  }

  .rec-table {
    width: 100%;
    border-collapse: collapse;
  }

  .rec-table th,
  .rec-table td {
    padding: 0.5rem 0.4rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color, #2a2a3a);
  }

  .rec-table th {
    background: var(--bg-secondary, #12121a);
  }

  .rec-table tbody tr:hover {
    background: var(--bg-secondary, #12121a);
  }

  .headset-name {
    font-weight: 500;
    color: var(--text-primary, #fff);
    white-space: nowrap;
  }

  .quick-picks td {
    vertical-align: top;
  }

  .quick-picks .notes {
    min-width: 12rem;
  }

  .info-table .headset-name {
    white-space: normal;
  }

  .price {
    font-family: monospace;
    color: var(--text-secondary, #888);
  }

  .spec {
    font-size: 0.85rem;
    color: var(--text-secondary, #ccc);
    white-space: nowrap;
  }

  .sortable {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  .sortable:hover {
    color: var(--accent-primary, #ff6b35);
  }

  .sortable::after {
    content: ' ↕';
    font-size: 0.65em;
    opacity: 0.4;
  }

  .sortable.asc::after {
