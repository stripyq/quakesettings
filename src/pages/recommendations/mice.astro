---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

// Get all players to count hardware usage
const allPlayers = await getCollection('players');
const players = allPlayers.filter(p => p.data.published !== false);

// Create mouse usage map and player list map
const mouseUsageMap = new Map<string, number>();
const mousePlayersMap = new Map<string, typeof players>();
players.forEach(p => {
  const mouseId = p.data.mouse;
  if (mouseId) {
    mouseUsageMap.set(mouseId, (mouseUsageMap.get(mouseId) || 0) + 1);
    if (!mousePlayersMap.has(mouseId)) {
      mousePlayersMap.set(mouseId, []);
    }
    mousePlayersMap.get(mouseId)!.push(p);
  }
});

// Map recommendation names to hardware slugs
const mouseSlugMap: Record<string, string> = {
  "VXE R1 Pro": "vxe-r1-pro",
  "Endgame Gear OP1 8K": "endgame-gear-op1-8k",
  "Pulsar Xlite V3 Crazy Light": "pulsar-xlite-v3-crazylight-medium",
  "G-Wolves HTS Ultra": "g-wolves-hts-ultra",
  "Logitech G Pro X Superlight 2": "logitech-g-pro-x-superlight-ii",
  "Ninjutso Sora V2": "ninjutso-sora-v2",
  "VAXEE NP-01S": "vaxee-np-01s-wireless",
  "VAXEE XE V2": "vaxee-xe-v2",
  "Incott G23 V2": "incott-g23-v2",
  "RAW Leviathan V4": "rawm-leviathan-v4",
  "ATK X1 / F1 V2": "atk-x1-v2-ultimate",
  "MCHOSE A5": "mchose-a5",
  "Asus ROG Harpe Ace 2": "asus-rog-harpe-ace-2",
  "MelGeek Horus": "melgeek-horus",
};

function getPlayerCount(name: string): number {
  const slug = mouseSlugMap[name];
  if (!slug) return 0;
  return mouseUsageMap.get(slug) || 0;
}

const allMice = await getCollection('mice');
const miceBySlug = new Map(allMice.map(m => [m.id, m.data]));

function getMouseData(name: string) {
  const slug = mouseSlugMap[name];
  if (!slug) return null;
  return miceBySlug.get(slug) || null;
}

function weightSortVal(weight?: string): number {
  if (!weight || weight === 'Unknown') return 999;
  return parseFloat(weight) || 999;
}

// Row-level shape/conn/weight are a fallback; the hardware file wins when both exist.
function getSpecs(m: { mouse: string; shape?: string; conn?: string; weight?: string }) {
  const md = getMouseData(m.mouse);
  const hwWeight = md?.weight && md.weight !== 'Unknown' ? md.weight : undefined;
  return {
    shape: md?.shape || m.shape,
    conn: md?.connection || m.conn,
    weight: hwWeight || m.weight,
  };
}

const mouseData: Array<{ mouse: string; price: string; dl: boolean; tl: boolean; bz: boolean; ju: boolean; shape?: string; conn?: string; weight?: string }> = [
  { mouse: "VXE R1 Pro", price: "$", dl: true, tl: true, bz: true, ju: true },
  { mouse: "Endgame Gear OP1 8K", price: "$$", dl: true, tl: true, bz: false, ju: true },
  { mouse: "Pulsar Xlite V3 Crazy Light", price: "$$", dl: false, tl: true, bz: true, ju: false },
  { mouse: "G-Wolves HTS Ultra", price: "$$", dl: false, tl: true, bz: true, ju: false },
  { mouse: "Logitech G Pro X Superlight 2", price: "$$$", dl: false, tl: false, bz: true, ju: true },
  { mouse: "Ninjutso Sora V2", price: "$$", dl: false, tl: true, bz: false, ju: true },
  { mouse: "VAXEE NP-01S", price: "$$", dl: false, tl: true, bz: false, ju: false },
  { mouse: "VAXEE XE V2", price: "$$", dl: false, tl: true, bz: false, ju: false },
  { mouse: "Incott G23 V2", price: "$", dl: false, tl: false, bz: false, ju: true },
  { mouse: "RAW Leviathan V4", price: "$$", dl: false, tl: false, bz: false, ju: true },
  { mouse: "ATK X1 / F1 V2", price: "$", dl: false, tl: true, bz: false, ju: true },
  { mouse: "MCHOSE A5", price: "$", dl: false, tl: false, bz: false, ju: true },
  { mouse: "Asus ROG Harpe Ace 2", price: "$$$", dl: false, tl: true, bz: false, ju: false },
  // Diamond Lobby 2026 picks
  { mouse: "Pulsar X2N CrazyLight Mini", price: "$$", dl: true, tl: false, bz: false, ju: false, shape: "Symmetrical", conn: "Wireless" },
  { mouse: "VAXEE NP-01 Ergo", price: "$$", dl: true, tl: false, bz: false, ju: false, shape: "Ergonomic", conn: "Wireless" },
  { mouse: "Razer Viper V4 Pro", price: "$$$", dl: true, tl: false, bz: false, ju: false, shape: "Symmetrical", conn: "Wireless" },
  { mouse: "Rapoo VT3 Max Gen 2", price: "$", dl: true, tl: false, bz: false, ju: false, shape: "Ergonomic", conn: "Wireless" },
  { mouse: "MCHOSE L7 Pro", price: "$$", dl: true, tl: false, bz: false, ju: false, shape: "Symmetrical", conn: "Wireless" },
  { mouse: "VXE R1 SE", price: "$", dl: true, tl: false, bz: false, ju: false, shape: "Ergonomic", conn: "Wireless", weight: "57g" },
  { mouse: "MelGeek Horus", price: "$$", dl: true, tl: false, bz: false, ju: false, shape: "Ambidextrous", conn: "Wireless", weight: "49g" },
  { mouse: "XBAB Tech XA25", price: "$$$", dl: true, tl: false, bz: false, ju: false, shape: "Symmetrical", conn: "Wireless", weight: "25g" },
];

// Sort by reviewer count, then by player count
const sortedMice = mouseData.sort((a, b) => {
  const aReviewers = (a.dl ? 1 : 0) + (a.tl ? 1 : 0) + (a.bz ? 1 : 0) + (a.ju ? 1 : 0);
  const bReviewers = (b.dl ? 1 : 0) + (b.tl ? 1 : 0) + (b.bz ? 1 : 0) + (b.ju ? 1 : 0);
  if (bReviewers !== aReviewers) return bReviewers - aReviewers;
  return getPlayerCount(b.mouse) - getPlayerCount(a.mouse);
});

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Recommended Gaming Mice for Quake Live",
  "description": "Best gaming mice recommended by competitive Quake Live players",
  "url": "https://stripyq.github.io/quakesettings/recommendations/mice/"
};
---

<BaseLayout title="Mice Recommendations" description="Best gaming mice for Quake Live recommended by competitive players. Lightweight, precise sensors, and pro-approved picks." schema={schema} ogImage="/images/og/recommendations.jpg">
  <div class="page-header">
    <h1>Gaming Mice Recommendations</h1>
    <p>Recommended mice from top reviewers (2025-2026)</p>
  </div>

  <div class="reviewer-legend">
    <span class="legend-item"><span class="badge dl">DL</span> Diamond Lobby</span>
    <span class="legend-item"><span class="badge tl">TL</span> Techless</span>
    <span class="legend-item"><span class="badge bz">BZ</span> Boardzy</span>
    <span class="legend-item"><span class="badge ju">JU</span> jakeu</span>
  </div>

  <div class="price-legend">
    <span>$ = Budget</span>
    <span>$$ = Mid-range</span>
    <span>$$$ = Premium</span>
  </div>

  <div class="table-container">
    <table class="rec-table reviewer-table" id="rec-table">
      <thead>
        <tr>
          <th>Mouse</th>
          <th class="num">Price</th>
          <th class="sortable" data-sort="shape" data-type="str">Shape</th>
          <th class="sortable" data-sort="conn" data-type="str">Conn</th>
          <th class="sortable num" data-sort="weight" data-type="num">Weight</th>
          <th class="rev-col">DL</th>
          <th class="rev-col">TL</th>
          <th class="rev-col">BZ</th>
          <th class="rev-col">JU</th>
          <th class="num">Players</th>
        </tr>
      </thead>
      <tbody>
        {sortedMice.map(m => {
          const playerCount = getPlayerCount(m.mouse);
          const slug = mouseSlugMap[m.mouse];
          const spec = getSpecs(m);
          return (
            <tr
              data-shape={spec.shape || ''}
              data-conn={spec.conn || ''}
              data-weight={weightSortVal(spec.weight)}
            >
              <td class="mouse-name" data-label="Mouse">{m.mouse}</td>
              <td class="price num" data-label="Price">{m.price}</td>
              <td class="spec" data-label="Shape">{spec.shape || <span class="empty-val">—</span>}</td>
              <td class="spec" data-label="Conn">{spec.conn || <span class="empty-val">—</span>}</td>
              <td class="spec num" data-label="Weight">{spec.weight || <span class="empty-val">—</span>}</td>
              <td class="center rev-col" data-label="DL">{m.dl ? '✓' : '–'}</td>
              <td class="center rev-col" data-label="TL">{m.tl ? '✓' : '–'}</td>
              <td class="center rev-col" data-label="BZ">{m.bz ? '✓' : '–'}</td>
              <td class="center rev-col" data-label="JU">{m.ju ? '✓' : '–'}</td>
              {/* Shown instead of the reviewer columns in the stacked mobile layout */}
              <td class="reviewers" data-label="Reviewers">{[m.dl && 'DL', m.tl && 'TL', m.bz && 'BZ', m.ju && 'JU'].filter(Boolean).join(', ') || <span class="empty-val">—</span>}</td>
              <td class="players num" data-label="Players">
                {playerCount > 0 ? (
                  <div class="usage-wrapper">
                    <span class="usage-count">{playerCount}</span>
                    <div class="player-dropdown">
                      {mousePlayersMap.get(slug)?.map(p => (
                        <a href={`${base}players/${p.id}/`}>{p.data.name}</a>
                      ))}
                    </div>
                  </div>
                ) : <span class="empty-val">—</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="back-link">
    <a href={`${base}recommendations/`}>← Back to Recommendations</a>
  </div>
</BaseLayout>

<style>
  .reviewer-legend {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--bg-secondary, #12121a);
    border-radius: var(--radius-md);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.75rem;
  }

  .badge.dl { background: #4a9eff; color: #000; }
  .badge.tl { background: #ff6b6b; color: #000; }
  .badge.bz { background: #ffd93d; color: #000; }
  .badge.ju { background: #6bcb77; color: #000; }

  .price-legend {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary, #888);
  }

  /* Table layout, mobile stacking and the player dropdown are shared in global.css (.reviewer-table) */
  /* Mouse, Price, Shape, Conn, Weight, four reviewers, Players */
  .reviewer-table th:nth-child(1) { width: 30%; }
  .reviewer-table th:nth-child(2) { width: 8%; }
  .reviewer-table th:nth-child(3) { width: 14%; }
  .reviewer-table th:nth-child(4) { width: 12%; }
  .reviewer-table th:nth-child(5) { width: 10%; }
  .reviewer-table th:nth-child(6) { width: 4%; }
  .reviewer-table th:nth-child(7) { width: 4%; }
  .reviewer-table th:nth-child(8) { width: 4%; }
  .reviewer-table th:nth-child(9) { width: 4%; }
  .reviewer-table th:nth-child(10) { width: 10%; }

  .back-link {
    margin-top: 2rem;
  }

  .back-link a {
    color: var(--accent-primary, #ff6b35);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const table = document.getElementById('rec-table');
  if (table) {
    const headers = table.querySelectorAll('th.sortable');
    const tbody = table.querySelector('tbody');
    headers.forEach(th => {
      th.addEventListener('click', () => {
        const key = th.dataset.sort;
        const type = th.dataset.type;
        const isAsc = th.classList.contains('asc');
        headers.forEach(h => h.classList.remove('asc', 'desc'));
        th.classList.add(isAsc ? 'desc' : 'asc');
        const dir = isAsc ? -1 : 1;
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort((a, b) => {
          const av = a.dataset[key] || '';
          const bv = b.dataset[key] || '';
          if (type === 'num') return (parseFloat(av) - parseFloat(bv)) * dir;
          return av.localeCompare(bv) * dir;
        });
        rows.forEach(r => tbody.appendChild(r));
      });
    });
  }
</script>
