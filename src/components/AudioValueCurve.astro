---
// Conceptual price vs. competitive-usefulness curve for the headsets page.
// Inline SVG so it picks up the site's CSS variables. The caption lives with the caller.

const W = 760;
const H = 360;
const plot = { left: 90, right: 736, top: 52, bottom: 204 };

const MIN_EUR = 20;
const MAX_EUR = 1000;
const logSpan = Math.log10(MAX_EUR) - Math.log10(MIN_EUR);

const r1 = (n: number) => Math.round(n * 10) / 10;
const xOf = (eur: number) => r1(plot.left + ((Math.log10(eur) - Math.log10(MIN_EUR)) / logSpan) * (plot.right - plot.left));
// frac: 0 = bottom of the plot, 1 = top
const yOf = (frac: number) => r1(plot.bottom - frac * (plot.bottom - plot.top));

const ticks = [20, 50, 100, 200, 500, 1000];
const levels = [
  { label: 'basic', frac: 1 / 6 },
  { label: 'capable', frac: 3 / 6 },
  { label: 'strong', frac: 5 / 6 },
];

const bands = [
  { from: 20, to: 150, opacity: 0.08, lines: ['accurate sound and good fit', 'available here'] },
  { from: 150, to: 350, opacity: 0.05, lines: ['comfort, build, tuning', 'variants, no-EQ options'] },
  { from: 350, to: 1000, opacity: 0.025, lines: ['materials, music,', 'preference'] },
];

// Illustrative shape only (EUR -> fraction of plot height), not measured data
const curvePoints: [number, number][] = [
  [20, 0.35], [50, 0.62], [100, 0.78], [150, 0.85], [250, 0.9], [500, 0.94], [1000, 0.96],
];

// Monotone cubic (Fritsch-Carlson) so the smoothed line never overshoots the points
function monotonePath(pts: [number, number][]): string {
  const n = pts.length;
  const dx: number[] = [];
  const slope: number[] = [];
  for (let i = 0; i < n - 1; i++) {
    dx[i] = pts[i + 1][0] - pts[i][0];
    slope[i] = (pts[i + 1][1] - pts[i][1]) / dx[i];
  }
  const m: number[] = [slope[0]];
  for (let i = 1; i < n - 1; i++) {
    m[i] = slope[i - 1] * slope[i] <= 0 ? 0 : (slope[i - 1] + slope[i]) / 2;
  }
  m[n - 1] = slope[n - 2];
  for (let i = 0; i < n - 1; i++) {
    if (slope[i] === 0) { m[i] = 0; m[i + 1] = 0; continue; }
    const a = m[i] / slope[i];
    const b = m[i + 1] / slope[i];
    const s = a * a + b * b;
    if (s > 9) {
      const t = 3 / Math.sqrt(s);
      m[i] = t * a * slope[i];
      m[i + 1] = t * b * slope[i];
    }
  }
  let d = `M${r1(pts[0][0])},${r1(pts[0][1])}`;
  for (let i = 0; i < n - 1; i++) {
    const h = dx[i] / 3;
    d += ` C${r1(pts[i][0] + h)},${r1(pts[i][1] + m[i] * h)} ${r1(pts[i + 1][0] - h)},${r1(pts[i + 1][1] - m[i + 1] * h)} ${r1(pts[i + 1][0])},${r1(pts[i + 1][1])}`;
  }
  return d;
}

const curvePath = monotonePath(curvePoints.map(([eur, frac]) => [xOf(eur), yOf(frac)]));

// Price ladder under the axis. row 1 staggers labels that would collide with the row 0 neighbour on their left.
const ladder = {
  baseline: 243,
  rowY: [252, 270],
};
const products = [
  { label: 'Koss KSC75', eur: 25, iem: false, row: 0 },
  { label: '7Hz Zero:2', eur: 27, iem: true, row: 1 },
  { label: 'Truthear Hexa', eur: 85, iem: true, row: 0 },
  { label: 'HD 560S', eur: 139, iem: false, row: 0 },
  { label: 'DT 900 Pro X', eur: 220, iem: false, row: 0 },
  { label: 'HD 490 Pro', eur: 339, iem: false, row: 0 },
  { label: 'CrinEar Reference', eur: 349, iem: true, row: 1 },
  { label: '1000 EUR flagship', eur: 1000, iem: false, row: 0 },
];
---

<div class="avc">
  <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img" aria-labelledby="avc-title avc-desc">
    <title id="avc-title">Diminishing returns in competitive audio</title>
    <desc id="avc-desc">A conceptual curve in which competitive usefulness rises steeply up to about 150 EUR and flattens above 350 EUR, with example products placed by price on a log scale below the axis.</desc>

    {bands.map(b => (
      <g>
        <rect class="band" x={xOf(b.from)} y={plot.top} width={r1(xOf(b.to) - xOf(b.from))} height={plot.bottom - plot.top} fill-opacity={b.opacity} />
        <text class="band-label" x={r1((xOf(b.from) + xOf(b.to)) / 2)} y="30" text-anchor="middle">
          {b.lines.map((line, i) => <tspan x={r1((xOf(b.from) + xOf(b.to)) / 2)} dy={i === 0 ? 0 : 12}>{line}</tspan>)}
        </text>
      </g>
    ))}
    {[150, 350].map(eur => <line class="band-edge" x1={xOf(eur)} x2={xOf(eur)} y1={plot.top} y2={plot.bottom} />)}

    {ticks.map(t => <line class="grid" x1={xOf(t)} x2={xOf(t)} y1={plot.top} y2={plot.bottom} />)}
    {levels.map(l => <line class="grid" x1={plot.left} x2={plot.right} y1={yOf(l.frac)} y2={yOf(l.frac)} />)}

    <line class="axis" x1={plot.left} x2={plot.right} y1={plot.bottom} y2={plot.bottom} />
    <line class="axis" x1={plot.left} x2={plot.left} y1={plot.top} y2={plot.bottom} />

    {ticks.map(t => (
      <g>
        <line class="axis" x1={xOf(t)} x2={xOf(t)} y1={plot.bottom} y2={plot.bottom + 4} />
        <text class="tick-label" x={xOf(t)} y={plot.bottom + 17} text-anchor="middle">{t}</text>
      </g>
    ))}
    <text class="axis-title" x={r1((plot.left + plot.right) / 2)} y={plot.bottom + 33} text-anchor="middle">Price (EUR, log scale)</text>

    {levels.map(l => <text class="tick-label" x={plot.left - 8} y={yOf(l.frac) + 4} text-anchor="end">{l.label}</text>)}
    <text class="axis-title" transform={`translate(18 ${r1((plot.top + plot.bottom) / 2)}) rotate(-90)`} text-anchor="middle">
      <tspan x="0" dy="0">Competitive usefulness</tspan>
      <tspan x="0" dy="13">(illustrative)</tspan>
    </text>

    <path class="curve" d={curvePath} />
    <text class="curve-label" x={plot.right - 4} y={yOf(0.94) + 18} text-anchor="end">conceptual curve, not measured</text>

    <g class="legend" transform={`translate(${plot.right - 150} 12)`}>
      <circle class="marker iem" cx="4" cy="-4" r="4" />
      <text x="13" y="0">IEM</text>
      <circle class="marker over-ear" cx="56" cy="-4" r="4" />
      <text x="65" y="0">Headphones</text>
    </g>

    <line class="ladder-base" x1={plot.left} x2={plot.right} y1={ladder.baseline} y2={ladder.baseline} />
    {products.map(p => {
      const x = xOf(p.eur);
      const y = ladder.rowY[p.row];
      return (
        <g>
          <title>{`${p.label}: ~${p.eur} EUR`}</title>
          <line class="ladder-tick" x1={x} x2={x} y1={ladder.baseline} y2={y - 4} />
          <circle class:list={['marker', p.iem ? 'iem' : 'over-ear']} cx={x} cy={y} r="4" />
          <text class="ladder-label" x={x + 2} y={y + 11} text-anchor="end" transform={`rotate(-45 ${x + 2} ${y + 11})`}>{p.label}</text>
        </g>
      );
    })}
  </svg>
</div>

<style>
  /* Below 600px the 11-13px labels would shrink past legibility, so scroll instead */
  .avc {
    overflow-x: auto;
  }

  .avc svg {
    display: block;
    height: auto;
    min-width: 600px;
  }

  .band { fill: var(--accent-secondary); }
  .band-edge { stroke: var(--border-color); stroke-width: 1; }
  .grid { stroke: var(--border-color); stroke-width: 1; }
  .axis { stroke: var(--text-muted); stroke-width: 1; }

  .tick-label { fill: var(--text-secondary); font-size: 12px; }
  .axis-title { fill: var(--text-muted); font-size: 12px; }
  .band-label { fill: var(--text-secondary); font-size: 11px; }

  .curve {
    fill: none;
    stroke: var(--accent-primary);
    stroke-width: 2;
    stroke-dasharray: 6 4;
    stroke-linecap: round;
  }
  .curve-label { fill: var(--text-muted); font-size: 11px; font-style: italic; }

  .legend text { fill: var(--text-secondary); font-size: 11px; }
  .marker { stroke: var(--accent-secondary); stroke-width: 1.5; }
  .marker.iem { fill: var(--accent-secondary); }
  .marker.over-ear { fill: none; }

  .ladder-base { stroke: var(--border-color); stroke-width: 1; }
  .ladder-tick { stroke: var(--text-muted); stroke-width: 1; }
  .ladder-label { fill: var(--text-secondary); font-size: 11px; }
</style>
